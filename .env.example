# ---------------------------------------------------------------------------
# JellyWish — modèle de configuration
# Copier ce fichier vers .env puis renseigner les valeurs.
# Aucun secret ne doit jamais être commité ni exposé par une API.
# ---------------------------------------------------------------------------

# --- Base de données (PostgreSQL) ------------------------------------------
# Avec le docker-compose fourni :
DATABASE_URL="postgresql://jellywish:jellywish@localhost:5432/jellywish?schema=public"

# --- Application -----------------------------------------------------------
# URL publique de JellyWish, utilisée pour le callback OIDC
APP_URL="http://localhost:3000"
# Secret Auth.js (sessions, CSRF) — générer avec : openssl rand -base64 32
AUTH_SECRET=""

# --- Kyros OIDC v1 (Obligatoire) -------------------------------------------
# Issuer public Kyros, ex. https://kyros.mhemery.fr
KYROS_ISSUER=""
# Client créé dans Administration → Clients SSO & OIDC (mode SSO Kyros / OIDC)
# Scopes à autoriser : openid profile email roles (offline_access si refresh voulu)
# Callback attendu : {APP_URL}/api/auth/callback/kyros
KYROS_CLIENT_ID=""
KYROS_CLIENT_SECRET=""

# --- TMDB (métadonnées) ----------------------------------------------------
TMDB_API_KEY=""
# Langue des métadonnées retournées par TMDB
TMDB_LANGUAGE="fr-FR"

# --- Jellyfin (facultatif) -------------------------------------------------
JELLYFIN_URL=""
JELLYFIN_API_KEY=""

# --- Radarr (facultatif) ---------------------------------------------------
RADARR_URL=""
RADARR_API_KEY=""

# --- Sonarr (facultatif) ---------------------------------------------------
SONARR_URL=""
SONARR_API_KEY=""

# --- Gotify (facultatif) ---------------------------------------------------
# Notifications de l'écosystème LUMA
GOTIFY_URL="https://notify.mhemery.fr"
GOTIFY_TOKEN=""

# --- qBittorrent (facultatif, supervision uniquement) ----------------------
QBITTORRENT_URL=""
QBITTORRENT_USERNAME=""
QBITTORRENT_PASSWORD=""

# --- Redis (jobs / workflows) ----------------------------------------------
REDIS_URL="redis://localhost:6379"
